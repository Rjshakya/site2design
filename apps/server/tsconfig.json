{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "lib": [
      "ESNext",
      "dom"
    ],
    "types": [
      "./worker-configuration.d.ts"
    ],
    "plugins": [
      {
        "name": "@effect/language-service"
      }
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx"
  },
}
