{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "server",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
   "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "0f2ec760632a46ec9c7698d205427c03",
      "localConnectionString": "postgres://site2design:site2design@localhost:5499/site2design"
    }
  ]

